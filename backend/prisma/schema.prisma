// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Color {
  white
  black
}

enum GameStatus {
  active
  finished
}

enum GameResult {
  white_wins
  black_wins
  draw
}

enum EndReason {
  checkmate
  stalemate
  draw
  timeout
  resignation
  agreement
}

enum InviteStatus {
  pending
  accepted
  declined
  cancelled
  expired
}

// One row per Supabase auth user. The id is the Supabase user id, so the
// profile can be upserted on the first authenticated request.
model Profile {
  id        String   @id @db.Uuid
  username  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")

  invitesSent     GameInvite[] @relation("InviteSender")
  invitesReceived GameInvite[] @relation("InviteRecipient")
}

model Game {
  id   String @id @default(uuid()) @db.Uuid
  
  whitePlayerId String? @db.Uuid
  blackPlayerId String? @db.Uuid
  whitePlayer   Profile? @relation("WhitePlayer", fields: [whitePlayerId], references: [id], onDelete: SetNull)
  blackPlayer   Profile? @relation("BlackPlayer", fields: [blackPlayerId], references: [id], onDelete: SetNull)

  timeControlId    String
  timeInitialMs    Int
  timeIncrementMs  Int
  whiteRemainingMs Int
  blackRemainingMs Int
  // Set to the time the side to move started thinking, to calculate the clock on the next move.
  lastMoveAt       DateTime?

  currentTurn Color      @default(white)
  status      GameStatus @default(active)
  result      GameResult?
  endReason   EndReason?
  // The side that has offered a draw and is waiting for the other side to answer.
  drawOfferedBy Color?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  moves Move[]
  invite GameInvite?

  @@index([whitePlayerId, createdAt])
  @@index([blackPlayerId, createdAt])
}

// An invitation to play a timed game. Accepting it creates the game, with the sender's color or a random one.
model GameInvite {
  id String @id @default(uuid()) @db.Uuid

  senderId    String  @db.Uuid
  recipientId String  @db.Uuid
  sender      Profile @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Profile @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  timeControlId String

  senderColor   Color?
  // Both player ids in sorted order while the invite is pending, empty afterwards. The unique
  // constraint then allows only one pending invite per pair, even when two requests race.
  pairKey       String?      @unique
  status        InviteStatus @default(pending)
  gameId        String?      @unique @db.Uuid
  game          Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([recipientId, status])
  @@index([senderId, status])
}

model Move {
  id     String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // 1-based move number in the game (white's first move is ply 1).
  ply    Int
  color  Color
  // Move payload as sent by the client (from/to squares and promotion).
  move   Json
  playedAt DateTime @default(now())

  @@unique([gameId, ply])
}
